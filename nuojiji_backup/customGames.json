[{"title":"七宗罪","description":"不知道诶，我也是看别人玩的","icon":"🎭","coverColor":"#9F7AEA","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>七宗罪 · 暗面画像</title>\n<style>\n:root{\n  --bg:#0e0a12;\n  --bg-deep:#1a141f;\n  --ink:#eee8f2;\n  --sub:#9a8a9f;\n  --card:#1e1826;\n  --line:rgba(200,180,210,.10);\n  --accent:#c026d3;\n  --safe-top:max(100px, env(safe-area-inset-top));\n  --safe-bottom:env(safe-area-inset-bottom, 16px);\n}\n* {\n  margin:0;\n  padding:0;\n  box-sizing:border-box;\n  -webkit-tap-highlight-color:transparent;\n}\nhtml, body {\n  width:100vw;\n  height:100vh;\n  overflow:hidden;\n  background:var(--bg);\n  color:var(--ink);\n  font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Helvetica Neue\",sans-serif;\n  touch-action:none;\n  overscroll-behavior:none;\n  -webkit-user-select:none;\n  user-select:none;\n}\n#app{\n  position:relative;\n  width:100vw;\n  height:100vh;\n  overflow:hidden;\n}\n.bg-wash{\n  position:absolute;\n  inset:0;\n  background:\n    radial-gradient(60% 40% at 15% 8%, rgba(185,28,28,.12), transparent 60%),\n    radial-gradient(55% 45% at 90% 12%, rgba(168,85,247,.10), transparent 60%),\n    radial-gradient(70% 50% at 50% 100%, rgba(190,24,93,.08), transparent 60%),\n    var(--bg);\n  z-index:0;\n}\n.screen{\n  position:absolute;\n  inset:0;\n  display:flex;\n  flex-direction:column;\n  padding-top:var(--safe-top);\n  padding-bottom:var(--safe-bottom);\n  padding-left:max(20px, env(safe-area-inset-left));\n  padding-right:max(20px, env(safe-area-inset-right));\n  opacity:0;\n  pointer-events:none;\n  transition:opacity .35s ease;\n  z-index:1;\n  overflow-y:auto;\n  overflow-x:hidden;\n}\n.screen.active{\n  opacity:1;\n  pointer-events:auto;\n}\n.icon-wrap{\n  width:110px;\n  height:110px;\n  margin:6px auto 18px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  position:relative;\n  flex-shrink:0;\n}\n.icon-ring{\n  position:absolute;\n  width:110px;\n  height:110px;\n  border-radius:50%;\n  background:radial-gradient(circle at 35% 30%, rgba(192,38,211,.22), transparent 70%);\n  animation:pulse 3s ease-in-out infinite;\n}\n.icon-core{\n  width:60px;\n  height:60px;\n  border-radius:50%;\n  background:radial-gradient(circle at 32% 28%, #f472e0, var(--accent) 100%);\n  box-shadow:0 0 26px rgba(192,38,211,.5);\n  animation:pulse 3s ease-in-out infinite;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:26px;\n}\n@keyframes pulse{\n  0%,100%{ transform:scale(.94); }\n  50%{ transform:scale(1.08); }\n}\n.eyebrow{\n  font-size:12px;\n  letter-spacing:.22em;\n  color:var(--sub);\n  text-transform:uppercase;\n  margin-bottom:6px;\n}\n#s-intro{\n  align-items:center;\n  text-align:center;\n  justify-content:flex-start;\n  padding-top:calc(var(--safe-top) + 4px);\n}\n.title-gothic{\n  font-family:\"Songti SC\",\"STSong\",\"SimSun\",serif;\n  font-size:25px;\n  font-weight:700;\n  line-height:1.4;\n  color:var(--ink);\n  margin-bottom:10px;\n}\n.lede{\n  font-size:13.5px;\n  line-height:1.75;\n  color:var(--sub);\n  max-width:310px;\n  margin:0 auto 20px;\n}\n.sin-chip-row{\n  display:flex;\n  flex-wrap:wrap;\n  gap:7px;\n  justify-content:center;\n  margin-bottom:22px;\n  max-width:340px;\n}\n.sin-chip{\n  font-size:12px;\n  padding:6px 11px;\n  border-radius:99px;\n  background:var(--card);\n  border:1px solid var(--line);\n  color:var(--ink);\n}\n.info-card{\n  width:100%;\n  max-width:340px;\n  margin:0 auto 16px;\n  background:var(--card);\n  border:1px solid var(--line);\n  border-radius:16px;\n  padding:14px 16px;\n  text-align:left;\n}\n.info-card h4{\n  font-size:12.5px;\n  color:var(--ink);\n  margin-bottom:5px;\n  font-weight:700;\n}\n.info-card p{\n  font-size:12px;\n  color:var(--sub);\n  line-height:1.7;\n}\n.spacer{\n  flex:1;\n  min-height:10px;\n}\n.btn-primary{\n  border:none;\n  width:100%;\n  max-width:340px;\n  margin:0 auto;\n  padding:15px;\n  border-radius:16px;\n  background:linear-gradient(135deg, var(--accent), #a21caf);\n  color:#fff;\n  font-size:15px;\n  font-weight:700;\n  box-shadow:0 8px 22px rgba(192,38,211,.32);\n  cursor:pointer;\n  display:block;\n}\n.btn-primary:active{ transform:scale(.98); }\n.btn-primary.char-mode{\n  background:linear-gradient(135deg, #be185d, #9f1239);\n  box-shadow:0 8px 22px rgba(190,24,93,.32);\n  margin-top:10px;\n}\n.btn-ghost{\n  border:none;\n  background:transparent;\n  color:var(--sub);\n  font-size:12.5px;\n  padding:12px;\n  margin-top:2px;\n  cursor:pointer;\n}\n.foot-note{\n  font-size:10.5px;\n  color:var(--sub);\n  opacity:.8;\n  margin-top:8px;\n  max-width:300px;\n  line-height:1.6;\n}\n.avatars{\n  display:flex;\n  justify-content:center;\n  gap:26px;\n  margin-bottom:14px;\n  flex-shrink:0;\n}\n.avatar-wrapper{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  position:relative;\n}\n.avatar-wrapper img{\n  width:58px;\n  height:58px;\n  border-radius:50%;\n  object-fit:cover;\n  border:2.5px solid var(--card);\n  background:var(--card);\n}\n.avatar-label{\n  font-size:12px;\n  font-weight:700;\n  margin-top:5px;\n  color:var(--sub);\n  max-width:66px;\n  text-align:center;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n.char-selector{ cursor:pointer; }\n.char-selector:active{ transform:scale(.95); }\n.change-badge{\n  position:absolute;\n  bottom:20px;\n  right:-6px;\n  background:var(--accent);\n  color:#fff;\n  font-size:9px;\n  padding:2px 6px;\n  border-radius:10px;\n  border:2px solid var(--card);\n}\n\n#s-quiz{ padding-top:var(--safe-top); }\n.progress-wrap{ flex-shrink:0; padding-bottom:12px; }\n.progress-top-row{\n  display:flex;\n  justify-content:space-between;\n  align-items:baseline;\n  margin-bottom:8px;\n}\n.section-tag{\n  font-size:12px;\n  font-weight:700;\n}\n.q-counter{ font-size:11.5px; color:var(--sub); }\n.progress-track{\n  height:5px;\n  border-radius:99px;\n  background:var(--line);\n  overflow:hidden;\n}\n.progress-fill{\n  height:100%;\n  border-radius:99px;\n  background:var(--accent);\n  transition:width .4s ease;\n}\n.q-body{\n  flex:1;\n  display:flex;\n  flex-direction:column;\n  justify-content:center;\n  min-height:0;\n}\n.q-card{\n  background:var(--card);\n  border:1px solid var(--line);\n  border-radius:20px;\n  padding:24px 20px;\n}\n.q-eyebrow{\n  font-size:11px;\n  color:var(--sub);\n  margin-bottom:10px;\n}\n.q-text{\n  font-size:17px;\n  line-height:1.6;\n  font-weight:600;\n  color:var(--ink);\n  margin-bottom:20px;\n  min-height:52px;\n}\n.opt-list{\n  display:flex;\n  flex-direction:column;\n  gap:9px;\n}\n.opt-btn{\n  text-align:left;\n  padding:13px 15px;\n  border-radius:13px;\n  background:var(--bg-deep);\n  border:1.5px solid var(--line);\n  font-size:14px;\n  color:var(--ink);\n  display:flex;\n  align-items:center;\n  gap:11px;\n  min-height:44px;\n  cursor:pointer;\n}\n.opt-btn:active{ transform:scale(.985); }\n.opt-btn .dot{\n  width:8px;\n  height:8px;\n  border-radius:50%;\n  background:var(--line);\n  flex-shrink:0;\n}\n.opt-btn.chosen{\n  background:rgba(192,38,211,.12);\n  border-color:var(--accent);\n}\n.opt-btn.chosen .dot{ background:var(--accent); }\n.q-nav{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  padding-top:12px;\n  flex-shrink:0;\n}\n.nav-btn{\n  background:none;\n  border:none;\n  font-size:12.5px;\n  color:var(--sub);\n  padding:10px 6px;\n  min-height:44px;\n  cursor:pointer;\n}\n.nav-btn:disabled{ opacity:.3; }\n\n#s-load{ align-items:center; justify-content:center; text-align:center; }\n.loading-title{\n  font-family:\"Songti SC\",\"STSong\",\"SimSun\",serif;\n  font-size:18px;\n  font-weight:700;\n  color:var(--ink);\n  margin-bottom:8px;\n}\n.loading-desc{\n  font-size:12.5px;\n  color:var(--sub);\n  line-height:1.7;\n}\n\n#s-res{\n  padding-top:calc(var(--safe-top) + 4px);\n  align-items:stretch;\n}\n.res-hero{\n  text-align:center;\n  margin-bottom:16px;\n  flex-shrink:0;\n}\n.res-hero h2{\n  font-family:\"Songti SC\",\"STSong\",\"SimSun\",serif;\n  font-size:20px;\n  line-height:1.5;\n}\n.res-hero p{\n  font-size:12.5px;\n  color:var(--sub);\n  margin-top:6px;\n  line-height:1.7;\n  max-width:300px;\n  margin-left:auto;\n  margin-right:auto;\n}\n.radar-card{\n  background:var(--card);\n  border:1px solid var(--line);\n  border-radius:18px;\n  padding:14px 6px 6px;\n  margin-bottom:14px;\n  flex-shrink:0;\n  display:flex;\n  justify-content:center;\n}\n.sin-card{\n  background:var(--card);\n  border:1px solid var(--line);\n  border-radius:16px;\n  padding:14px 16px;\n  margin-bottom:10px;\n}\n.sin-head{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  margin-bottom:7px;\n}\n.sin-name{\n  font-size:14px;\n  font-weight:700;\n}\n.sin-score{\n  font-size:12px;\n  color:var(--sub);\n}\n.sin-level{\n  font-size:12px;\n  font-weight:700;\n  margin-bottom:6px;\n}\n.sin-bar-track{\n  height:7px;\n  border-radius:99px;\n  background:var(--line);\n  overflow:hidden;\n  margin-bottom:8px;\n}\n.sin-bar-fill{\n  height:100%;\n  border-radius:99px;\n}\n.sin-desc{\n  font-size:12px;\n  color:var(--sub);\n  line-height:1.7;\n}\n.res-actions{\n  display:flex;\n  flex-direction:column;\n  gap:9px;\n  margin-top:6px;\n  padding-bottom:6px;\n  flex-shrink:0;\n}\n.btn-secondary{\n  border:1.5px solid var(--line);\n  background:var(--card);\n  padding:13px;\n  border-radius:14px;\n  font-size:13.5px;\n  color:var(--ink);\n  font-weight:600;\n  cursor:pointer;\n}\n.legal{\n  font-size:10px;\n  color:var(--sub);\n  opacity:.75;\n  text-align:center;\n  line-height:1.7;\n  margin-top:12px;\n  padding-bottom:8px;\n}\n.chat-card{\n  background:var(--card);\n  border:1px solid var(--line);\n  border-radius:16px;\n  margin-bottom:10px;\n  overflow:hidden;\n}\n.chat-header{\n  padding:12px 16px 8px;\n  border-bottom:1px solid var(--line);\n  display:flex;\n  align-items:center;\n  gap:9px;\n}\n.chat-header img{\n  width:30px;\n  height:30px;\n  border-radius:50%;\n  object-fit:cover;\n}\n.chat-header-name{\n  font-size:13px;\n  font-weight:700;\n  color:var(--ink);\n}\n.chat-header-status{\n  font-size:10.5px;\n  color:var(--sub);\n}\n.chat-box{\n  padding:12px 14px;\n  max-height:240px;\n  overflow-y:auto;\n  display:flex;\n  flex-direction:column;\n  gap:9px;\n}\n.msg-wrapper{\n  display:flex;\n  flex-direction:column;\n  max-width:82%;\n}\n.msg-wrapper.char{ align-self:flex-start; }\n.msg-wrapper.user{ align-self:flex-end; }\n.msg{\n  padding:9px 13px;\n  border-radius:13px;\n  font-size:12.5px;\n  line-height:1.6;\n  word-wrap:break-word;\n}\n.msg.char{\n  background:var(--bg-deep);\n  color:var(--ink);\n  border-bottom-left-radius:4px;\n}\n.msg.user{\n  background:var(--accent);\n  color:#fff;\n  border-bottom-right-radius:4px;\n}\n.msg.system{\n  align-self:center;\n  background:transparent;\n  color:var(--sub);\n  font-size:11px;\n  text-align:center;\n  max-width:100%;\n}\n.chat-input-area{\n  display:flex;\n  gap:7px;\n  padding:9px 13px 13px;\n  border-top:1px solid var(--line);\n}\n.chat-input-area input{\n  flex:1;\n  border:1px solid var(--line);\n  border-radius:99px;\n  padding:0 13px;\n  font-size:13px;\n  outline:none;\n  background:var(--bg-deep);\n  color:var(--ink);\n  height:36px;\n}\n.chat-input-area button{\n  background:var(--accent);\n  color:#fff;\n  border:none;\n  width:36px;\n  height:36px;\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:15px;\n  cursor:pointer;\n  flex-shrink:0;\n}\n::-webkit-scrollbar{ width:3px; }\n::-webkit-scrollbar-thumb{ background:rgba(192,38,211,.2); border-radius:99px; }\n</style>\n</head>\n<body>\n<div id=\"app\">\n<div class=\"bg-wash\"></div>\n\n<div class=\"screen active\" id=\"s-intro\">\n  <div class=\"icon-wrap\"><div class=\"icon-ring\"></div><div class=\"icon-core\">🔥</div></div>\n  <div class=\"avatars\" id=\"av-row\" style=\"display:none;\">\n    <div class=\"avatar-wrapper\">\n      <img id=\"av-u\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2NCIgaGVpZ2h0PSI2NCI+PHJlY3Qgd2lkdGg9IjY0IiBoZWlnaHQ9IjY0IiBmaWxsPSIjMjIyIi8+PC9zdmc+\" alt=\"\">\n      <span class=\"avatar-label\" id=\"av-un\">你</span>\n    </div>\n    <div class=\"avatar-wrapper char-selector\" onclick=\"pickChar()\">\n      <img id=\"av-c\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2NCIgaGVpZ2h0PSI2NCI+PHJlY3Qgd2lkdGg9IjY0IiBoZWlnaHQ9IjY0IiBmaWxsPSIjMjIyIi8+PC9zdmc+\" alt=\"\">\n      <span class=\"avatar-label\" id=\"av-cn\">TA</span>\n      <div class=\"change-badge\">更换</div>\n    </div>\n  </div>\n  <div class=\"eyebrow\">SEVEN SINS · 七宗罪</div>\n  <h1 class=\"title-gothic\" id=\"i-title\">照见你的<br>七重暗面</h1>\n  <p class=\"lede\">每个人内心都住着七个影子——傲慢、嫉妒、暴怒、懒惰、贪婪、暴食、色欲。它们藏得有多深？</p>\n  <div class=\"sin-chip-row\">\n    <div class=\"sin-chip\">🔴 傲慢</div>\n    <div class=\"sin-chip\">💚 嫉妒</div>\n    <div class=\"sin-chip\">🔥 暴怒</div>\n    <div class=\"sin-chip\">🌫️ 懒惰</div>\n    <div class=\"sin-chip\">💰 贪婪</div>\n    <div class=\"sin-chip\">🍷 暴食</div>\n    <div class=\"sin-chip\">💋 色欲</div>\n  </div>\n  <div class=\"info-card\">\n    <h4>关于这个测试</h4>\n    <p>基于西方古典\"七宗罪\"概念重构的心理画像测试，共 42 题（每宗罪 6 题），约需 5–7 分钟。请凭真实感受作答，没有对错。</p>\n  </div>\n  <div class=\"spacer\"></div>\n  <button class=\"btn-primary\" id=\"btn-go\">我来测 · 开始画像</button>\n  <button class=\"btn-primary char-mode\" id=\"btn-go-char\">让 <span id=\"cn-btn\">TA</span> 来测 · 看TA的暗面</button>\n  <button class=\"btn-ghost\">这是一次自我探索，不构成道德评判 →</button>\n  <p class=\"foot-note\">测试结果仅供娱乐与自我觉察，不作为任何诊断依据。</p>\n</div>\n\n<div class=\"screen\" id=\"s-quiz\">\n  <div class=\"progress-wrap\">\n    <div class=\"progress-top-row\">\n      <div class=\"section-tag\" id=\"q-tag\">🔴 傲慢</div>\n      <div class=\"q-counter\" id=\"q-cnt\">1 / 42</div>\n    </div>\n    <div class=\"progress-track\"><div class=\"progress-fill\" id=\"q-bar\" style=\"width:0%\"></div></div>\n  </div>\n  <div class=\"q-body\">\n    <div class=\"q-card\">\n      <div class=\"q-eyebrow\" id=\"q-eye\">请选择最符合你的程度</div>\n      <div class=\"q-text\" id=\"q-txt\">加载中</div>\n      <div class=\"opt-list\" id=\"q-opts\"></div>\n    </div>\n  </div>\n  <div class=\"q-nav\">\n    <button class=\"nav-btn\" id=\"btn-back\">← 上一题</button>\n    <button class=\"nav-btn\" id=\"btn-exit\">退出测试</button>\n  </div>\n</div>\n\n<div class=\"screen\" id=\"s-load\">\n  <div style=\"flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;\">\n    <div class=\"icon-wrap\"><div class=\"icon-ring\"></div><div class=\"icon-core\">😈</div></div>\n    <div class=\"loading-title\" id=\"ld-t\">TA 正在审视自己的暗面…</div>\n    <div class=\"loading-desc\">AI 正在阅读全部 42 道题<br>并根据内心深处作答<br>请耐心等待约 10–20 秒</div>\n  </div>\n</div>\n\n<div class=\"screen\" id=\"s-res\">\n  <div class=\"res-hero\">\n    <div class=\"eyebrow\" id=\"r-eye\">你的七宗罪画像</div>\n    <h2 id=\"r-title\">正在描绘暗面…</h2>\n    <p id=\"r-sub\"></p>\n  </div>\n  <div class=\"radar-card\"><div id=\"r-radar\"></div></div>\n  <div id=\"r-sins\"></div>\n  <div class=\"chat-card\" id=\"r-chat\" style=\"display:none;\">\n    <div class=\"chat-header\">\n      <img id=\"ch-av\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2NCIgaGVpZ2h0PSI2NCI+PHJlY3Qgd2lkdGg9IjY0IiBoZWlnaHQ9IjY0IiBmaWxsPSIjMjIyIi8+PC9zdmc+\" alt=\"\">\n      <div>\n        <div class=\"chat-header-name\" id=\"ch-n\">TA</div>\n        <div class=\"chat-header-status\">想和你聊聊这份结果</div>\n      </div>\n    </div>\n    <div class=\"chat-box\" id=\"ch-box\"></div>\n    <div class=\"chat-input-area\">\n      <input type=\"text\" id=\"ch-inp\" placeholder=\"和TA聊聊…\">\n      <button id=\"ch-send\">↑</button>\n    </div>\n  </div>\n  <div class=\"res-actions\">\n    <button class=\"btn-primary\" id=\"btn-share\">分享我的七宗罪画像</button>\n    <button class=\"btn-secondary\" id=\"btn-retry\">再测一次</button>\n  </div>\n  <p class=\"legal\">本测试基于西方宗教伦理概念改编，用于娱乐与自我探索，不构成道德评判或心理诊断。</p>\n</div>\n\n</div>\n\n<script>\nif (!window.Nuojiji) {\n  window.Nuojiji = {\n    getUser: async () => ({ id:'dev', nickname:'', avatar:'' }),\n    getChar: async () => ({ id:'c', name:'', avatar:'', description:'' }),\n    getCharList: async () => [],\n    ai: async () => ({ success:false }),\n    close: () => {},\n    shareResult: async () => ({ shared:false }),\n    pickChars: async () => ({ picked:false, chars:[] }),\n    onGameStateRequest: () => {}\n  };\n}\n\nvar SCALE_OPTS = [\n  { l:'完全不符', v:1 },\n  { l:'不太符合', v:2 },\n  { l:'一般', v:3 },\n  { l:'比较符合', v:4 },\n  { l:'非常符合', v:5 }\n];\n\nvar SINS = [\n  { key:'pride', name:'傲慢', emoji:'🔴', color:'#ef4444', prompt:'你觉得自己在这些方面如何？', items:[\n    '我觉得自己在很多方面比大多数人优秀',\n    '当别人质疑我时，我内心会很不快',\n    '我很难真心接受自己犯错或失败',\n    '我常觉得自己应该被特殊对待',\n    '我不太能忍受被人忽视或看轻',\n    '我对自己的品味和判断力非常自信'\n  ]},\n  { key:'envy', name:'嫉妒', emoji:'💚', color:'#10b981', prompt:'面对他人时，你是否有这些感受？', items:[\n    '看到别人过得比我好，我心里不舒服',\n    '我会暗自比较自己和他人的成就',\n    '我很难坦然接受别人比我更有天赋',\n    '当朋友获得好事时，我内心有一丝失落',\n    '我希望得到别人拥有的东西或地位',\n    '我常觉得命运对别人比对我更宽容'\n  ]},\n  { key:'wrath', name:'暴怒', emoji:'🔥', color:'#f97316', prompt:'关于愤怒和冲突…', items:[\n    '我很容易被激怒或生气',\n    '生气时我很难快速平静下来',\n    '我会记住那些伤害过我的人',\n    '我想过要报复让我不爽的人',\n    '我发火时可能会说或做过激的事',\n    '被冒犯时我很难选择原谅'\n  ]},\n  { key:'sloth', name:'懒惰', emoji:'🌫️', color:'#818cf8', prompt:'关于行动和努力…', items:[\n    '我常拖延重要的事情',\n    '我很难长时间保持专注努力',\n    '我倾向于选择最省力的方式',\n    '我会逃避需要大量付出的事',\n    '我经常感到疲惫、提不起劲',\n    '面对困难我很快就想放弃'\n  ]},\n  { key:'greed', name:'贪婪', emoji:'💰', color:'#eab308', prompt:'对于拥有和获取…', items:[\n    '我总觉得自己拥有的还不够',\n    '我很在意物质财富和资源',\n    '我不太愿意把自己的东西分享出去',\n    '我会为了利益做一些妥协',\n    '即使已经足够我还是想要更多',\n    '我很难满足于当前的状态'\n  ]},\n  { key:'gluttony', name:'暴食', emoji:'🍷', color:'#c084fc', prompt:'关于欲望和放纵…', items:[\n    '我很难抵抗诱惑和即时满足',\n    '我容易沉迷于某些让我快乐的事',\n    '我常常过度消费或消耗',\n    '我很难做到适可而止',\n    '我会用吃东西/购物/刷手机来填补空虚',\n    '我明知不好还是会放纵自己'\n  ]},\n  { key:'lust', name:'色欲', emoji:'💋', color:'#f472b6', prompt:'关于欲望和吸引…', items:[\n    '我容易被外貌或魅力吸引',\n    '我对亲密关系有很强的渴望',\n    '我会幻想或沉浸于情欲的念头',\n    '我很难抗拒来自他人的诱惑',\n    '我对感官刺激有很高的需求',\n    '我在欲望面前很难保持理性'\n  ]}\n];\n\nvar BANDS = [\n  { upTo:10, lv:'几乎无影', desc:'这份罪在你身上几乎找不到痕迹。' },\n  { upTo:16, lv:'隐约浮现', desc:'偶尔会有这样的念头，但很快就消散了。' },\n  { upTo:22, lv:'暗流涌动', desc:'这份欲望在你心底有一定存在感，时常隐约出现。' },\n  { upTo:26, lv:'深刻烙印', desc:'这是你性格中相当鲜明的一面，经常影响你的选择。' },\n  { upTo:30, lv:'支配之罪', desc:'这份本能几乎主宰了你的某些行为模式。' }\n];\n\nfunction getBand(sum) {\n  for (var i = 0; i < BANDS.length; i++) {\n    if (sum <= BANDS[i].upTo) return BANDS[i];\n  }\n  return BANDS[BANDS.length - 1];\n}\n\nvar QS = [];\nSINS.forEach(function(s, si) {\n  s.items.forEach(function(t, ti) {\n    QS.push({ si: si, ti: ti, text: t });\n  });\n});\nvar TOTAL = QS.length;\n\nvar ans = new Array(TOTAL).fill(null);\nvar cur = 0;\nvar taker = 'user';\nvar userInfo = { nickname: '' };\nvar charInfo = { name: '', avatar: '', description: '' };\nvar chatHist = [];\nvar scores = null;\n\nfunction $(id) { return document.getElementById(id); }\nfunction showScreen(id) {\n  var all = document.querySelectorAll('.screen');\n  for (var i = 0; i < all.length; i++) all[i].classList.remove('active');\n  $(id).classList.add('active');\n}\n\nasync function initGame() {\n  try {\n    var u = await Nuojiji.getUser();\n    if (u) {\n      userInfo = u;\n      if (u.avatar) $('av-u').src = u.avatar;\n      if (u.nickname) $('av-un').textContent = u.nickname;\n    }\n    var c = await Nuojiji.getChar();\n    if (c && c.name) {\n      setChar(c);\n      $('av-row').style.display = 'flex';\n    }\n    if (userInfo.nickname) {\n      $('i-title').innerHTML = userInfo.nickname + '，<br>照见你的七重暗面';\n    }\n  } catch (e) {}\n}\n\nfunction setChar(c) {\n  charInfo = c;\n  $('av-cn').textContent = c.name;\n  $('cn-btn').textContent = c.name;\n  if (c.avatar) $('av-c').src = c.avatar;\n}\n\nasync function pickChar() {\n  try {\n    var r = await Nuojiji.pickChars({ min:1, max:1, title:'选择要测试的角色' });\n    if (r.picked && r.chars && r.chars[0]) {\n      setChar(r.chars[0]);\n      $('av-row').style.display = 'flex';\n    }\n  } catch (e) {}\n}\n\nfunction renderQ() {\n  var q = QS[cur];\n  var s = SINS[q.si];\n  $('q-tag').textContent = s.emoji + ' ' + s.name;\n  $('q-tag').style.color = s.color;\n  $('q-cnt').textContent = (cur + 1) + ' / ' + TOTAL;\n  $('q-bar').style.width = (cur / (TOTAL - 1) * 100).toFixed(1) + '%';\n  $('q-bar').style.background = s.color;\n  $('q-eye').textContent = s.prompt;\n  $('q-txt').textContent = q.text;\n\n  var list = $('q-opts');\n  list.innerHTML = '';\n  SCALE_OPTS.forEach(function(o) {\n    var btn = document.createElement('button');\n    btn.className = 'opt-btn' + (ans[cur] === o.v ? ' chosen' : '');\n    btn.innerHTML = '<span class=\"dot\"></span><span>' + o.l + '</span>';\n    btn.onclick = function() { selAns(o.v); };\n    list.appendChild(btn);\n  });\n  $('btn-back').disabled = (cur === 0);\n}\n\nfunction selAns(v) {\n  ans[cur] = v;\n  renderQ();\n  setTimeout(function() {\n    if (cur < TOTAL - 1) {\n      cur++;\n      renderQ();\n    } else {\n      finish();\n    }\n  }, 200);\n}\n\nasync function charTest() {\n  $('ld-t').textContent = charInfo.name + ' 正在审视自己的暗面…';\n  showScreen('s-load');\n\n  var qTxt = '';\n  var n = 0;\n  SINS.forEach(function(s) {\n    qTxt += '\\n【' + s.emoji + s.name + '】' + s.prompt + '\\n';\n    s.items.forEach(function(t) {\n      n++;\n      qTxt += n + '. ' + t + '\\n';\n    });\n  });\n\n  var prompt = '你是' + charInfo.name + '。' + (charInfo.description || '') +\n    '\\n做一份七宗罪自评，共42题。每题1-5分（1=完全不符，5=非常符合）。' +\n    '\\n根据你的性格和内心真实想法打分。\\n' + qTxt +\n    '\\n【输出格式】直接输出42个数字(1-5)，用逗号分隔，不要任何其他文字！' +\n    '\\n示例：3,2,4,1,5,3,2,4,3,1,5,2,3,4,2,1,3,5,2,4,3,1,2,4,5,3,2,1,4,3,2,5,1,3,4,2,3,1,4,2,5,3';\n\n  try {\n    var res = await Nuojiji.ai({ messages:[{ role:'system', content: prompt }], maxTokens: 400 });\n    if (!res.success) throw new Error('fail');\n    var nums = res.text.match(/[1-5]/g);\n    if (nums && nums.length >= 20) {\n      for (var i = 0; i < TOTAL; i++) {\n        ans[i] = Math.max(1, Math.min(5, parseInt(nums[i]) || 3));\n      }\n      finish();\n    } else {\n      throw new Error('parse');\n    }\n  } catch (e) {\n    for (var j = 0; j < TOTAL; j++) {\n      ans[j] = Math.floor(Math.random() * 5) + 1;\n    }\n    finish();\n  }\n}\n\nfunction compute() {\n  var res = {};\n  SINS.forEach(function(s, si) {\n    var sum = 0;\n    s.items.forEach(function(_, ti) {\n      var idx = -1;\n      for (var i = 0; i < QS.length; i++) {\n        if (QS[i].si === si && QS[i].ti === ti) { idx = i; break; }\n      }\n      sum += (ans[idx] || 3);\n    });\n    res[s.key] = { sum: sum, pct: ((sum - 6) / 24 * 100) };\n  });\n  return res;\n}\n\nfunction buildRadar(dims) {\n  var size = 260, cx = size / 2, cy = size / 2, R = 84, n = dims.length;\n  function ang(i) { return (-Math.PI / 2) + i * (2 * Math.PI / n); }\n  function pt(i, r) {\n    var a = ang(i);\n    return [cx + r * Math.cos(a), cy + r * Math.sin(a)];\n  }\n  var svg = '';\n  [0.25, 0.5, 0.75, 1].forEach(function(f) {\n    var p = [];\n    for (var i = 0; i < n; i++) {\n      var xy = pt(i, R * f);\n      p.push(xy[0].toFixed(1) + ',' + xy[1].toFixed(1));\n    }\n    svg += '<polygon points=\"' + p.join(' ') + '\" fill=\"none\" stroke=\"rgba(200,180,210,.15)\" stroke-width=\"1\"/>';\n  });\n  for (var i = 0; i < n; i++) {\n    var xy2 = pt(i, R);\n    svg += '<line x1=\"' + cx + '\" y1=\"' + cy + '\" x2=\"' + xy2[0].toFixed(1) + '\" y2=\"' + xy2[1].toFixed(1) + '\" stroke=\"rgba(200,180,210,.15)\" stroke-width=\"1\"/>';\n  }\n  var dp = [];\n  for (var i = 0; i < n; i++) {\n    var r = Math.max(8, (dims[i].pct / 100) * R);\n    var xy3 = pt(i, r);\n    dp.push(xy3[0].toFixed(1) + ',' + xy3[1].toFixed(1));\n  }\n  svg += '<polygon points=\"' + dp.join(' ') + '\" fill=\"rgba(192,38,211,.25)\" stroke=\"#c026d3\" stroke-width=\"2\" stroke-linejoin=\"round\"/>';\n  for (var i = 0; i < n; i++) {\n    var r2 = Math.max(8, (dims[i].pct / 100) * R);\n    var xy4 = pt(i, r2);\n    svg += '<circle cx=\"' + xy4[0].toFixed(1) + '\" cy=\"' + xy4[1].toFixed(1) + '\" r=\"4\" fill=\"' + dims[i].color + '\"/>';\n  }\n  for (var i = 0; i < n; i++) {\n    var xy5 = pt(i, R + 22);\n    var anchor = 'middle';\n    if (xy5[0] < cx - 10) anchor = 'end';\n    else if (xy5[0] > cx + 10) anchor = 'start';\n    svg += '<text x=\"' + xy5[0].toFixed(1) + '\" y=\"' + xy5[1].toFixed(1) + '\" text-anchor=\"' + anchor + '\" font-size=\"11\" font-weight=\"700\" fill=\"#eee8f2\" dominant-baseline=\"middle\">' + dims[i].emoji + ' ' + dims[i].name + '</text>';\n  }\n  return '<svg width=\"' + size + '\" height=\"' + (size + 8) + '\" viewBox=\"0 0 ' + size + ' ' + (size + 8) + '\" xmlns=\"http://www.w3.org/2000/svg\">' + svg + '</svg>';\n}\n\nfunction finish() {\n  scores = compute();\n  var dims = SINS.map(function(s) {\n    return { name: s.name, emoji: s.emoji, color: s.color, pct: scores[s.key].pct };\n  });\n  $('r-radar').innerHTML = buildRadar(dims);\n\n  var isC = (taker === 'char');\n  $('r-eye').textContent = isC ? (charInfo.name + ' 的七宗罪画像') : '你的七宗罪画像';\n\n  var maxKey = '', maxSum = 0;\n  SINS.forEach(function(s) {\n    if (scores[s.key].sum > maxSum) { maxSum = scores[s.key].sum; maxKey = s.key; }\n  });\n  var domSin = SINS.filter(function(s) { return s.key === maxKey; })[0];\n  $('r-title').textContent = (isC ? charInfo.name : '你') + '的支配之罪：' + domSin.emoji + domSin.name;\n  $('r-sub').textContent = '七个维度，没有好坏——只有此刻最真实的画像。';\n\n  var holder = $('r-sins');\n  holder.innerHTML = '';\n  SINS.forEach(function(s) {\n    var sc = scores[s.key];\n    var band = getBand(sc.sum);\n    var card = document.createElement('div');\n    card.className = 'sin-card';\n    card.innerHTML =\n      '<div class=\"sin-head\"><div class=\"sin-name\" style=\"color:' + s.color + '\">' + s.emoji + ' ' + s.name + '</div><div class=\"sin-score\">' + sc.sum + '/30</div></div>' +\n      '<div class=\"sin-level\" style=\"color:' + s.color + '\">' + band.lv + '</div>' +\n      '<div class=\"sin-bar-track\"><div class=\"sin-bar-fill\" style=\"width:' + sc.pct.toFixed(0) + '%;background:' + s.color + '\"></div></div>' +\n      '<div class=\"sin-desc\">' + band.desc + '</div>';\n    holder.appendChild(card);\n  });\n\n  $('btn-share').onclick = async function() {\n    var lines = SINS.map(function(s) { return s.emoji + s.name + ' ' + scores[s.key].sum + '/30'; }).join('  ');\n    try {\n      await Nuojiji.shareResult({\n        title: (isC ? charInfo.name + '的七宗罪画像' : '我的七宗罪画像'),\n        summary: '支配之罪：' + domSin.emoji + domSin.name + '\\n' + lines,\n        accentColor: '#c026d3',\n        badge: '😈 七宗罪'\n      });\n    } catch (e) {}\n  };\n\n  setupChat();\n  showScreen('s-res');\n}\n\nfunction setupChat() {\n  var card = $('r-chat');\n  if (!charInfo.name) {\n    card.style.display = 'none';\n    return;\n  }\n  card.style.display = '';\n  $('ch-n').textContent = charInfo.name;\n  if (charInfo.avatar) $('ch-av').src = charInfo.avatar;\n  $('ch-box').innerHTML = '<div class=\"msg system\">TA正在查看结果…</div>';\n  chatHist = [];\n\n  var summary = '';\n  SINS.forEach(function(s) {\n    var sc = scores[s.key];\n    var band = getBand(sc.sum);\n    summary += s.emoji + s.name + '：' + sc.sum + '/30（' + band.lv + '）\\n';\n  });\n\n  var isC = (taker === 'char');\n  var sys;\n  if (isC) {\n    sys = '你是' + charInfo.name + '。' + (charInfo.description || '') +\n      '\\n你刚完成了七宗罪画像测试，结果：\\n' + summary +\n      '\\n' + (userInfo.nickname || '对方') + '想和你聊聊。用自然口语回复1-3句话，可用换行分条。不要括号动作描写。';\n  } else {\n    sys = '你是' + charInfo.name + '。' + (charInfo.description || '') +\n      '\\n' + (userInfo.nickname || '对方') + '刚完成了七宗罪画像测试，结果：\\n' + summary +\n      '\\n请根据你的性格和你们的关系聊聊这份结果。回复1-3句话，可用换行分条。不要括号动作描写。';\n  }\n  var firstMsg = isC ? '我看到你的结果了，哪个最准？' : '我测完了，你看看我的七宗罪？';\n  chatHist = [{ role:'system', content: sys }, { role:'user', content: firstMsg }];\n  aiChat();\n}\n\nasync function aiChat() {\n  try {\n    var res = await Nuojiji.ai({\n      messages: chatHist.map(function(m) { return { role: m.role, content: m.content }; }),\n      maxTokens: 600\n    });\n    var sysMsg = $('ch-box').querySelector('.msg.system');\n    if (sysMsg) sysMsg.remove();\n    if (res.success) {\n      handleReply(res.text);\n    } else {\n      addSys('TA暂时无法回应');\n    }\n  } catch (e) {\n    var sysMsg2 = $('ch-box').querySelector('.msg.system');\n    if (sysMsg2) sysMsg2.remove();\n    addSys('网络请求失败');\n  }\n}\n\nfunction handleReply(text) {\n  var parts = text.split('\\n').map(function(p) { return p.trim(); }).filter(function(p) { return p.length > 0; });\n  parts.forEach(function(p) {\n    addMsg(p, 'char');\n    chatHist.push({ role:'assistant', content: p });\n  });\n}\n\nfunction addMsg(text, role) {\n  var box = $('ch-box');\n  var sysMsg = box.querySelector('.msg.system');\n  if (sysMsg) sysMsg.remove();\n  var w = document.createElement('div');\n  w.className = 'msg-wrapper ' + role;\n  var d = document.createElement('div');\n  d.className = 'msg ' + role;\n  d.textContent = text;\n  w.appendChild(d);\n  box.appendChild(w);\n  box.scrollTop = box.scrollHeight;\n}\n\nfunction addSys(text) {\n  var box = $('ch-box');\n  var d = document.createElement('div');\n  d.className = 'msg system';\n  d.textContent = text;\n  box.appendChild(d);\n  box.scrollTop = box.scrollHeight;\n}\n\nasync function sendChat() {\n  var inp = $('ch-inp');\n  var text = inp.value.trim();\n  if (!text) return;\n  inp.value = '';\n  inp.blur();\n  addMsg(text, 'user');\n  chatHist.push({ role:'user', content: text });\n  addSys('TA正在输入…');\n  try {\n    var msgs = chatHist.map(function(m) { return { role: m.role, content: m.content }; });\n    msgs[msgs.length - 1].content += '\\n\\n【回复1-3句，完整句子，换行分条。】';\n    var res = await Nuojiji.ai({ messages: msgs, maxTokens: 600 });\n    var sysMsg = $('ch-box').querySelector('.msg.system');\n    if (sysMsg) sysMsg.remove();\n    if (res.success) {\n      handleReply(res.text);\n    } else {\n      addSys('发送失败');\n    }\n  } catch (e) {\n    var sysMsg2 = $('ch-box').querySelector('.msg.system');\n    if (sysMsg2) sysMsg2.remove();\n    addSys('网络错误');\n  }\n}\n\n// Wire up events\n$('btn-go').onclick = function() {\n  taker = 'user';\n  cur = 0;\n  ans = new Array(TOTAL).fill(null);\n  renderQ();\n  showScreen('s-quiz');\n};\n$('btn-go-char').onclick = function() {\n  taker = 'char';\n  ans = new Array(TOTAL).fill(null);\n  if (!charInfo.name) {\n    pickChar().then(function() {\n      if (charInfo.name) charTest();\n    });\n  } else {\n    charTest();\n  }\n};\n$('btn-exit').onclick = function() { showScreen('s-intro'); };\n$('btn-back').onclick = function() { if (cur > 0) { cur--; renderQ(); } };\n$('btn-retry').onclick = function() {\n  ans = new Array(TOTAL).fill(null);\n  cur = 0;\n  chatHist = [];\n  scores = null;\n  showScreen('s-intro');\n};\n$('ch-send').onclick = sendChat;\n$('ch-inp').addEventListener('keypress', function(e) {\n  if (e.key === 'Enter') sendChat();\n});\n\n(function() {\n  var inp = $('ch-inp');\n  var box = $('ch-box');\n  if (window.visualViewport) {\n    window.visualViewport.addEventListener('resize', function() {\n      document.body.style.height = window.visualViewport.height + 'px';\n      window.scrollTo(0, 0);\n      if (box) box.scrollTop = box.scrollHeight;\n    });\n  }\n  if (inp) {\n    inp.addEventListener('focus', function() {\n      setTimeout(function() { if (box) box.scrollTop = box.scrollHeight; }, 300);\n    });\n    inp.addEventListener('blur', function() { window.scrollTo(0, 0); });\n  }\n})();\n\ninitGame();\n</script>\n</body>\n</html>\n","usesAI":true,"createdAt":1786459048245,"id":1}]